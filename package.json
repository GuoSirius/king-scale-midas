{
  "name": "king-scale-midas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "nuxt dev",
    "dev:local": "node scripts/local-db.mjs && nuxt dev",
    "build": "nuxt build",
    "build:local": "node scripts/local-db.mjs && nuxt build",
    "preview:local": "node .output/server/index.mjs",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "db:generate": "drizzle-kit generate",
    "db:local": "node scripts/local-db.mjs",
    "db:local:reset": "node scripts/local-db.mjs --reset",
    "db:seed:demo": "node scripts/seed-demo.mjs",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "collect:local": "python collector/run.py",
    "collect:local:today": "python collector/run.py --date today"
  },
  "dependencies": {
    "@unocss/nuxt": "latest",
    "@vite-pwa/nuxt": "latest",
    "drizzle-orm": "latest",
    "nitro-cloudflare-dev": "latest",
    "nuxt": "latest",
    "unocss": "latest",
    "vue": "latest"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "drizzle-kit": "latest",
    "typescript": "latest",
    "wrangler": "latest"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.25.12": true,
    "esbuild@0.18.20": true,
    "workerd@1.20260730.1": true
  }
}
