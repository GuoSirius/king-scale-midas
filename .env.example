# 复制为 .env 并填入真实值（.env 已被 .gitignore 忽略，不要提交）

# ── Web 服务端（Nuxt runtimeConfig，必须带 NUXT_ 前缀才会覆盖） ──
# /api/ingest 的 HMAC-SHA256 签名密钥
NUXT_INGEST_SECRET=change-me-ingest-secret
# 会话 cookie 签名密钥（建议 32 字节随机 hex）
NUXT_SESSION_SECRET=change-me-session-secret-please-use-32-bytes-random

# ── 采集器（collector / scripts，读的是无前缀版本） ──
# 必须与 NUXT_INGEST_SECRET 完全一致，否则签名校验 401
INGEST_SECRET=change-me-ingest-secret
INGEST_URL=http://localhost:3000/api/ingest

# ── 本地 A 备模式（node:sqlite） ──
# 不设则默认 .data/local.db
# LOCAL_D1_PATH=
