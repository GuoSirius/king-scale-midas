# 复制为 .env 并填入真实值（不要提交 .env）

# 采集器 → /api/ingest 的 HMAC 签名密钥（与 collector 端一致）
INGEST_SECRET=change-me-ingest-secret
# 服务端会话 cookie 签名密钥（建议 32 字节随机 hex）
SESSION_SECRET=change-me-session-secret-please-use-32-bytes-random

# D1 本地开发（@cloudflare/nuxt 通过 wrangler.toml 读取，通常无需在此设置）
# CLOUDFLARE_D1_DB_ID=
